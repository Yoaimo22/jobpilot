# ─── Database (Supabase PostgreSQL) ───
# Supabase → Project Settings → Database → Connection string → "URI".
# IMPORTANT for Vercel: use the pooled connection (port 6543) for DATABASE_URL,
# and the direct connection (port 5432) for DIRECT_URL (used by migrations).
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ─── Auth ───
# Generate: openssl rand -base64 32   (or any long random string)
AUTH_SECRET="change-me-generate-a-long-random-secret"
# On Vercel set this to your deployed URL, e.g. https://jobpilot-you.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ─── Supabase Storage (private CV files) ───
# Supabase → Project Settings → API. Create a PRIVATE bucket named "cvs".
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-only secret, never exposed to browser
SUPABASE_STORAGE_BUCKET="cvs"

# Local-dev fallback storage (ignored when Supabase is configured)
STORAGE_DIR="./storage/private"

# ─── Cover letter generation (optional) ───
LLM_API_BASE=""
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# ─── Redis (optional) ───
REDIS_URL=""
